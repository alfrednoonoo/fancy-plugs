# Build output and fetched dependencies
/build/
/.deps/
/dist/
/screens/
/out/
/site/
/content/

# Python's caches, from the models in docs/research
__pycache__/

# Editors and agents
.claude/
.vs/
.vscode/
.idea/
*.user

# Secrets: FIGMA_TOKEN lives in the environment only, never in a file
.env
.env.*

# The manual builder's intermediate files.
tools/manual/work/

# The intro film: build.py writes these from film.py, docs/images and assets/fonts.
content-src/video/*/index.html
content-src/video/*/compositions/
content-src/video/*/assets/screens/
content-src/video/*/assets/fonts/
content-src/video/*/.hyperframes/

# The REAPER theme generator writes its images and zips here (tools/theme/build.py).
theme/build/
