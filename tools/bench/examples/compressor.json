{
  "name": "Compressor, 4:1 at -20 dB",
  "notes": "Fancy Comp against TDR Kotelnikov (free; parameter names checked on 9 November 2026) and FabFilter Pro-C 3 (30-day trial from fabfilter.com/download; names checked on 17 November 2026 with 3.0.2; skipped if not installed). Pro-C 3's defaults that would differ from Fancy Comp's are set: Auto Gain off (on by default) and its side-chain EQ's 85 Hz low cut off (on by default), so its detector hears the bass as Fancy Comp's does.",
  "sampleRate": 48000,
  "blockSizes": [
    128
  ],
  "plugins": [
    {
      "label": "Fancy Comp",
      "path": "%FANCY_VST3%/Fancy Comp.vst3",
      "params": {
        "Threshold": "-20",
        "Ratio": "4",
        "Knee": "6",
        "Attack": "10",
        "Release": "100"
      }
    },
    {
      "label": "TDR Kotelnikov",
      "path": "%COMMONPROGRAMFILES%/VST3/TDR Kotelnikov.vst3",
      "params": {
        "Threshold": "-20",
        "Ratio": "4",
        "Attack": "10",
        "Release Peak": "100"
      }
    },
    {
      "label": "FabFilter Pro-C 3",
      "path": "%COMMONPROGRAMFILES%/VST3/FabFilter Pro-C 3.vst3",
      "params": {
        "Style": "Clean",
        "Threshold": "-20",
        "Ratio": "4",
        "Knee": "6",
        "Range": "60",
        "Attack": "10",
        "Release": "100",
        "Auto Release": "Off",
        "Auto Threshold": "Off",
        "Lookahead": "0",
        "Hold": "0",
        "Character": "Off",
        "Auto Gain": "Off",
        "Side Chain EQ Band 1 Used": "Unused",
        "Oversampling": "Off"
      }
    }
  ],
  "tests": {
    "cpu": {
      "seconds": 20,
      "repeats": 5
    },
    "latency": {},
    "response": {
      "level": -10
    },
    "thd": {
      "frequencies": [
        100,
        1000
      ],
      "levels": [
        -30,
        -20,
        -10,
        0
      ]
    },
    "aliasing": {
      "frequencies": [
        5000,
        10000
      ],
      "level": 0
    },
    "clicks": {
      "param": "Threshold",
      "from": "-40",
      "to": "-10",
      "period": 0.05
    }
  }
}