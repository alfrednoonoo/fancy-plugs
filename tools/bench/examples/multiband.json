{
  "name": "Multiband, 4 bands, 4:1 at -20 dB",
  "notes": "Fancy MultiComp against Convergence Free (Cut Through Recordings, free, four bands). The same four bands on each: crossovers at 120 Hz, 1.2 kHz and 6 kHz, every band 4:1 at -20 dB, attack 10 ms, release 100 ms. Convergence's per-band settings are set one by one: its global Threshold, Ratio, Attack and Release only reach the bands through its own window, not from the host. KolinMB, which has no threshold or ratio, is in multiband-kolin.json. FabFilter Pro-MB (30-day trial from fabfilter.com/download; skipped if not installed) has the same bands with knee 6 dB, like Fancy MultiComp's default, and lookahead 0.",
  "sampleRate": 48000,
  "blockSizes": [
    128
  ],
  "plugins": [
    {
      "label": "Fancy MultiComp",
      "path": "%FANCY_VST3%/Fancy MultiComp.vst3",
      "params": {
        "Bands": "4",
        "Band 1 Top frequency": "120",
        "Band 2 Top frequency": "1200",
        "Band 3 Top frequency": "6000",
        "Band 1 Threshold": "-20",
        "Band 1 Ratio": "4",
        "Band 1 Attack": "10",
        "Band 1 Release": "100",
        "Band 1 Auto release": "Off",
        "Band 2 Threshold": "-20",
        "Band 2 Ratio": "4",
        "Band 2 Attack": "10",
        "Band 2 Release": "100",
        "Band 2 Auto release": "Off",
        "Band 3 Threshold": "-20",
        "Band 3 Ratio": "4",
        "Band 3 Attack": "10",
        "Band 3 Release": "100",
        "Band 3 Auto release": "Off",
        "Band 4 Threshold": "-20",
        "Band 4 Ratio": "4",
        "Band 4 Attack": "10",
        "Band 4 Release": "100",
        "Band 4 Auto release": "Off"
      }
    },
    {
      "label": "Convergence Free",
      "path": "%COMMONPROGRAMFILES%/VST3/Cut Through Recordings Convergence-64.vst3",
      "params": {
        "number of bands": "4",
        "Crossover 1": "120",
        "Crossover 2": "1200",
        "Crossover 3": "6000",
        "Threshold B1": "-20",
        "Ratio B1": "4",
        "Attack B1": "10",
        "Release B1": "100",
        "Threshold B2": "-20",
        "Ratio B2": "4",
        "Attack B2": "10",
        "Release B2": "100",
        "Threshold B3": "-20",
        "Ratio B3": "4",
        "Attack B3": "10",
        "Release B3": "100",
        "Threshold B4": "-20",
        "Ratio B4": "4",
        "Attack B4": "10",
        "Release B4": "100"
      },
      "clicks": {
        "param": "Threshold B2",
        "from": "-40",
        "to": "-10"
      }
    },
    {
      "label": "FabFilter Pro-MB",
      "path": "%COMMONPROGRAMFILES%/VST3/FabFilter Pro-MB.vst3",
      "todo": "trial; names not checked yet: run FancyBench params on it, fix any name that differs, then delete this todo. Its bands may need creating by hand (they are added in its window, and 'Used' may not be enough): if the report shows fewer than four bands, set them up in REAPER, export a preset into examples\\presets\\pro-mb-4-bands.vstpreset and add it here as \"preset\". Range limits each band's gain change: it must allow at least 15 dB",
      "params": {
        "Band 1 Used": "Used",
        "Band 1 Enabled": "Enabled",
        "Band 2 Used": "Used",
        "Band 2 Enabled": "Enabled",
        "Band 3 Used": "Used",
        "Band 3 Enabled": "Enabled",
        "Band 4 Used": "Used",
        "Band 4 Enabled": "Enabled",
        "Band 1 Upper Frequency": "120",
        "Band 2 Upper Frequency": "1200",
        "Band 3 Upper Frequency": "6000",
        "Band 1 Mode": "Compress",
        "Band 1 Threshold": "-20",
        "Band 1 Ratio": "4",
        "Band 1 Range": "-48",
        "Band 1 Knee": "6",
        "Band 1 Attack": "10",
        "Band 1 Release": "100",
        "Band 1 Lookahead": "0",
        "Band 2 Mode": "Compress",
        "Band 2 Threshold": "-20",
        "Band 2 Ratio": "4",
        "Band 2 Range": "-48",
        "Band 2 Knee": "6",
        "Band 2 Attack": "10",
        "Band 2 Release": "100",
        "Band 2 Lookahead": "0",
        "Band 3 Mode": "Compress",
        "Band 3 Threshold": "-20",
        "Band 3 Ratio": "4",
        "Band 3 Range": "-48",
        "Band 3 Knee": "6",
        "Band 3 Attack": "10",
        "Band 3 Release": "100",
        "Band 3 Lookahead": "0",
        "Band 4 Mode": "Compress",
        "Band 4 Threshold": "-20",
        "Band 4 Ratio": "4",
        "Band 4 Range": "-48",
        "Band 4 Knee": "6",
        "Band 4 Attack": "10",
        "Band 4 Release": "100",
        "Band 4 Lookahead": "0"
      },
      "clicks": {
        "param": "Band 2 Threshold",
        "from": "-40",
        "to": "-10"
      }
    }
  ],
  "tests": {
    "cpu": {
      "seconds": 20,
      "repeats": 5
    },
    "latency": {},
    "response": {
      "level": -10
    },
    "thd": {
      "frequencies": [
        100,
        1000
      ],
      "levels": [
        -30,
        -20,
        -10,
        0
      ]
    },
    "aliasing": {
      "frequencies": [
        5000,
        10000
      ],
      "level": 0
    },
    "clicks": {
      "param": "Band 2 Threshold",
      "from": "-40",
      "to": "-10",
      "period": 0.05
    }
  }
}