{
  "name": "Multiband, 4 bands, 4:1 at -20 dB",
  "notes": "Fancy MultiComp against Convergence Free (Cut Through Recordings, free, four bands). The same four bands on each: crossovers at 120 Hz, 1.2 kHz and 6 kHz, every band 4:1 at -20 dB, attack 10 ms, release 100 ms. Convergence's per-band settings are set one by one: its global Threshold, Ratio, Attack and Release only reach the bands through its own window, not from the host. KolinMB, which has no threshold or ratio, is in multiband-kolin.json. FabFilter Pro-MB (30-day trial from fabfilter.com/download; skipped if not installed) has the same four bands as edges of LR 24 band-passes (its Low and High Crossover per band; band 1 starts at its lowest, band 4 ends at its highest), knee 6 dB like Fancy MultiComp's default, lookahead off, and Range wide open (it starts at 0 dB, which would stop any compression). Its attack and release are in percent, not ms, so they stay at its defaults (20 %) and don't match.",
  "sampleRate": 48000,
  "blockSizes": [
    128
  ],
  "plugins": [
    {
      "label": "Fancy MultiComp",
      "path": "%FANCY_VST3%/Fancy MultiComp.vst3",
      "params": {
        "Bands": "4",
        "Band 1 Top frequency": "120",
        "Band 2 Top frequency": "1200",
        "Band 3 Top frequency": "6000",
        "Band 1 Threshold": "-20",
        "Band 1 Ratio": "4",
        "Band 1 Attack": "10",
        "Band 1 Release": "100",
        "Band 1 Auto release": "Off",
        "Band 2 Threshold": "-20",
        "Band 2 Ratio": "4",
        "Band 2 Attack": "10",
        "Band 2 Release": "100",
        "Band 2 Auto release": "Off",
        "Band 3 Threshold": "-20",
        "Band 3 Ratio": "4",
        "Band 3 Attack": "10",
        "Band 3 Release": "100",
        "Band 3 Auto release": "Off",
        "Band 4 Threshold": "-20",
        "Band 4 Ratio": "4",
        "Band 4 Attack": "10",
        "Band 4 Release": "100",
        "Band 4 Auto release": "Off"
      }
    },
    {
      "label": "Convergence Free",
      "path": "%COMMONPROGRAMFILES%/VST3/Cut Through Recordings Convergence-64.vst3",
      "params": {
        "number of bands": "4",
        "Crossover 1": "120",
        "Crossover 2": "1200",
        "Crossover 3": "6000",
        "Threshold B1": "-20",
        "Ratio B1": "4",
        "Attack B1": "10",
        "Release B1": "100",
        "Threshold B2": "-20",
        "Ratio B2": "4",
        "Attack B2": "10",
        "Release B2": "100",
        "Threshold B3": "-20",
        "Ratio B3": "4",
        "Attack B3": "10",
        "Release B3": "100",
        "Threshold B4": "-20",
        "Ratio B4": "4",
        "Attack B4": "10",
        "Release B4": "100"
      },
      "clicks": {
        "param": "Threshold B2",
        "from": "-40",
        "to": "-10"
      }
    },
    {
      "label": "FabFilter Pro-MB",
      "path": "%COMMONPROGRAMFILES%/VST3/FabFilter Pro-MB.vst3",
      "todo": "names checked on 17 November 2026 with 1.3.3; still to confirm on the first run: that 'Enabled' is a value Band State takes, and that Range -48 means up to 48 dB of reduction (the report shows each value as set). Then delete this todo",
      "params": {
        "Band 1 State": "Enabled",
        "Band 1 Low Crossover": "10",
        "Band 1 Low Slope": "24",
        "Band 1 High Crossover": "120",
        "Band 1 High Slope": "24",
        "Band 1 Dynamics Mode": "Compression",
        "Band 1 Threshold": "-20",
        "Band 1 Ratio": "4",
        "Band 1 Range": "-48",
        "Band 1 Knee": "6",
        "Band 1 Lookahead": "0",
        "Band 1 Side Chain Filtering": "Band",
        "Band 2 State": "Enabled",
        "Band 2 Low Crossover": "120",
        "Band 2 Low Slope": "24",
        "Band 2 High Crossover": "1200",
        "Band 2 High Slope": "24",
        "Band 2 Dynamics Mode": "Compression",
        "Band 2 Threshold": "-20",
        "Band 2 Ratio": "4",
        "Band 2 Range": "-48",
        "Band 2 Knee": "6",
        "Band 2 Lookahead": "0",
        "Band 2 Side Chain Filtering": "Band",
        "Band 3 State": "Enabled",
        "Band 3 Low Crossover": "1200",
        "Band 3 Low Slope": "24",
        "Band 3 High Crossover": "6000",
        "Band 3 High Slope": "24",
        "Band 3 Dynamics Mode": "Compression",
        "Band 3 Threshold": "-20",
        "Band 3 Ratio": "4",
        "Band 3 Range": "-48",
        "Band 3 Knee": "6",
        "Band 3 Lookahead": "0",
        "Band 3 Side Chain Filtering": "Band",
        "Band 4 State": "Enabled",
        "Band 4 Low Crossover": "6000",
        "Band 4 Low Slope": "24",
        "Band 4 High Crossover": "30000",
        "Band 4 High Slope": "24",
        "Band 4 Dynamics Mode": "Compression",
        "Band 4 Threshold": "-20",
        "Band 4 Ratio": "4",
        "Band 4 Range": "-48",
        "Band 4 Knee": "6",
        "Band 4 Lookahead": "0",
        "Band 4 Side Chain Filtering": "Band",
        "Lookahead Enabled": "Off",
        "Oversampling": "Off"
      },
      "clicks": {
        "param": "Band 2 Threshold",
        "from": "-40",
        "to": "-10"
      }
    }
  ],
  "tests": {
    "cpu": {
      "seconds": 20,
      "repeats": 5
    },
    "latency": {},
    "response": {
      "level": -10
    },
    "thd": {
      "frequencies": [
        100,
        1000
      ],
      "levels": [
        -30,
        -20,
        -10,
        0
      ]
    },
    "aliasing": {
      "frequencies": [
        5000,
        10000
      ],
      "level": 0
    },
    "clicks": {
      "param": "Band 2 Threshold",
      "from": "-40",
      "to": "-10",
      "period": 0.05
    }
  }
}