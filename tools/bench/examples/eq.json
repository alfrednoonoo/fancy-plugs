{
  "name": "EQ, +6 dB bell at 1 kHz",
  "notes": "Fancy EQ against TDR Nova (free; parameter names checked on 9 November 2026) and FabFilter Pro-Q 4 (30-day trial from fabfilter.com/download; names checked on 17 November 2026 with 4.1.3; skipped if not installed). Nova's EQ Auto Gain is off, so the EQs are compared at the same level.",
  "sampleRate": 48000,
  "blockSizes": [
    128
  ],
  "plugins": [
    {
      "label": "Fancy EQ",
      "path": "%FANCY_VST3%/Fancy EQ.vst3",
      "params": {
        "Band 2 Freq": "1000",
        "Band 2 Gain": "6",
        "Band 2 Q": "1"
      }
    },
    {
      "label": "TDR Nova",
      "path": "%COMMONPROGRAMFILES%/VST3/TDR Nova.vst3",
      "params": {
        "Band 2 Active": "On",
        "Band 2 Frequency": "1000",
        "Band 2 Gain": "6",
        "Band 2 Q": "1",
        "EQ Auto Gain": "Off"
      }
    },
    {
      "label": "FabFilter Pro-Q 4",
      "path": "%COMMONPROGRAMFILES%/VST3/FabFilter Pro-Q 4.vst3",
      "params": {
        "Band 1 Used": "Used",
        "Band 1 Enabled": "Enabled",
        "Band 1 Shape": "Bell",
        "Band 1 Frequency": "1000",
        "Band 1 Gain": "6",
        "Band 1 Q": "1",
        "Band 1 Dynamic Range": "0",
        "Band 1 Spectral Enabled": "Disabled",
        "Processing Mode": "Zero Latency",
        "Character": "Clean",
        "Gain Scale": "100",
        "Auto Gain": "Off"
      },
      "clicks": {
        "param": "Band 1 Gain",
        "from": "0",
        "to": "12"
      }
    }
  ],
  "tests": {
    "cpu": {
      "seconds": 20,
      "repeats": 5
    },
    "latency": {},
    "response": {
      "level": -20
    },
    "thd": {
      "frequencies": [
        100,
        1000,
        5000
      ],
      "levels": [
        -20,
        0
      ]
    },
    "clicks": {
      "param": "Band 2 Gain",
      "from": "0",
      "to": "12",
      "period": 0.05
    }
  }
}